# CarePoint local development template. Copy to .env.local only on your machine.
# Never commit real .env files. Generate production secrets with a vault/password manager.

NODE_ENV=development
API_PORT=4000
HEALTH_CHECK_TIMEOUT_MS=2500

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/care_center
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/care_center
REDIS_URL=redis://localhost:6379

# Use different random values per environment. Minimum recommended length: 32 chars.
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-local-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
MEDICAL_PROFILE_ENCRYPTION_KEY=change-me-local-medical-key-min-32-chars

FRONTEND_PROVIDER_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001
FRONTEND_PATIENT_URL=http://localhost:3002
FRONTEND_PROVIDER_MOBILE_URL=http://localhost:8081
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8080,http://localhost:8081
ALLOW_LOCALHOST_CORS_WILDCARD=true

AUTH_CHALLENGE_REDIS_ENABLED=false
AUTH_CHALLENGE_REDIS_PREFIX=carepoint:auth:challenge
PRIVILEGED_ALLOWED_EMAIL_DOMAINS=
SSO_ENABLED=false
SSO_PROVIDER_NAME=Enterprise SSO
SSO_AUTHORIZE_URL=
SSO_CLIENT_ID=
SSO_CALLBACK_URL=
SSO_SCOPE=openid profile email

TELEHEALTH_VENDOR=daily
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Emergency-only: keep false/empty in production so missing Prisma models fail fast.
ALLOW_AUDIT_FALLBACK_IN_PRODUCTION=false


# ---------- Hybrid Python progressive adoption ----------
PYTHON_SERVICES_BASE_URL=http://localhost:8010
PYTHON_SERVICES_SHARED_SECRET=change-me-local-python-bridge-secret-min-32-chars
PYTHON_SERVICES_TIMEOUT_MS=2500
PYTHON_SERVICES_SIGN_REQUESTS=true
PYTHON_WORKER_API_PORT=8010
PYTHON_WORKER_QUEUE_ENABLED=false
PYTHON_WORKER_JOB_STATUS_REDIS_ENABLED=false
PYTHON_WORKER_JOB_STATUS_TTL_SECONDS=86400
PYTHON_WORKER_REQUIRE_SHARED_SECRET=false
PYTHON_WORKER_REQUIRE_SIGNATURE=false
PYTHON_WORKER_ALLOW_LEGACY_SECRET_HEADER=true
PYTHON_WORKER_SIGNATURE_TOLERANCE_SECONDS=300
PYTHON_WORKER_METRICS_ENABLED=true
PYTHON_WORKER_OTEL_ENABLED=false
PYTHON_WORKER_ARTIFACT_STORAGE_DIR=/tmp/carepoint-python-worker/artifacts
PYTHON_WORKER_ROLLOUT_STATE_PATH=/tmp/carepoint-python-worker/rollout-state.json
HYBRID_PYTHON_ENABLED=false
HYBRID_PYTHON_CANARY_PERCENT=0
HYBRID_PYTHON_SHADOW_MODE=true
HYBRID_PYTHON_USE_CONTROL_PLANE_ASSIGNMENT=false
HYBRID_PYTHON_CONTROL_PLANE_FAIL_OPEN=false
HYBRID_PYTHON_DEFAULT_ROUTE=/api/hybrid-python/jobs
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379
