{
  "name": "@care-center/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build --workspace @care-center/contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "npm run prisma:migrate:deploy && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset:pilot": "tsx prisma/reset-pilot-seed.ts",
    "db:initadmin": "tsx prisma/init-admin.ts",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@care-center/contracts": "0.1.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.18.0",
    "redis": "^4.7.0",
    "socket.io": "4.8.3",
    "stripe": "^16.8.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.1.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "5.5.3",
    "vitest": "^2.1.9",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
