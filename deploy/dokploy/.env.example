# ---------- Public domains ----------
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
PROVIDER_DOMAIN=provider.example.com
PATIENT_DOMAIN=patient.example.com
PROVIDER_MOBILE_DOMAIN=provider-mobile.example.com

# ---------- Database / cache ----------
POSTGRES_DB=care_center
POSTGRES_USER=carecenter
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql://carecenter:change-this-postgres-password@postgres:5432/care_center?schema=public
DIRECT_URL=postgresql://carecenter:change-this-postgres-password@postgres:5432/care_center?schema=public
REDIS_URL=redis://redis:6379

# ---------- API ----------
API_PORT=4000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_CHALLENGE_REDIS_ENABLED=true
AUTH_CHALLENGE_REDIS_PREFIX=carepoint:auth:challenge
ALLOW_LOCALHOST_CORS_WILDCARD=false

FRONTEND_ADMIN_URL=https://admin.example.com
FRONTEND_PROVIDER_URL=https://provider.example.com
FRONTEND_PATIENT_URL=https://patient.example.com
FRONTEND_PROVIDER_MOBILE_URL=https://provider-mobile.example.com
FRONTEND_ALLOWED_ORIGINS=https://admin.example.com,https://provider.example.com,https://patient.example.com,https://provider-mobile.example.com

# ---------- Next.js public runtime/build values ----------
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_ALLOW_DEMO_SIGNIN=false

# ---------- Flutter web build values ----------
PATIENT_API_BASE_URL=https://api.example.com
PROVIDER_MOBILE_API_BASE_URL=https://api.example.com

# ---------- Optional integrations ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TELEHEALTH_VENDOR=daily
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Email (OTP). Preferred provider: Resend HTTP API (set RESEND_API_KEY).
# RESEND_API_KEY is a SECRET: set the real value only in the Dokploy
# environment, never commit it. EMAIL_FROM must be either Resend's shared
# testing sender "onboarding@resend.dev" (only delivers to your own account
# email) or an address on a domain verified in your Resend account.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CarePoint <onboarding@resend.dev>
# Optional SMTP fallback (used only if RESEND_API_KEY is empty):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PRIVILEGED_ALLOWED_EMAIL_DOMAINS=
SSO_ENABLED=false
SSO_PROVIDER_NAME=Enterprise SSO
SSO_AUTHORIZE_URL=
SSO_CLIENT_ID=
SSO_CALLBACK_URL=
SSO_SCOPE=openid profile email


# ---------- Hybrid Python progressive adoption ----------
PYTHON_SERVICES_BASE_URL=http://python-worker-api:8010
PYTHON_SERVICES_SHARED_SECRET=replace-with-long-random-python-bridge-secret
PYTHON_SERVICES_TIMEOUT_MS=2500
PYTHON_SERVICES_SIGN_REQUESTS=true
PYTHON_SERVICES_USE_HMAC_SIGNATURE=true
PYTHON_WORKER_API_PORT=8010
PYTHON_WORKER_QUEUE_ENABLED=false
PYTHON_WORKER_JOB_STATUS_REDIS_ENABLED=false
PYTHON_WORKER_JOB_STATUS_TTL_SECONDS=86400
PYTHON_WORKER_REQUIRE_SHARED_SECRET=true
PYTHON_WORKER_REQUIRE_SIGNATURE=true
PYTHON_WORKER_ALLOW_LEGACY_SECRET_HEADER=false
PYTHON_WORKER_SIGNATURE_TOLERANCE_SECONDS=300
PYTHON_WORKER_METRICS_ENABLED=true
PYTHON_WORKER_OTEL_ENABLED=false
PYTHON_WORKER_ARTIFACT_STORAGE_DIR=/tmp/carepoint-python-worker/artifacts
PYTHON_WORKER_ROLLOUT_STATE_PATH=/tmp/carepoint-python-worker/rollout-state.json
HYBRID_PYTHON_ENABLED=false
HYBRID_PYTHON_CANARY_PERCENT=0
HYBRID_PYTHON_SHADOW_MODE=true
HYBRID_PYTHON_USE_CONTROL_PLANE_ASSIGNMENT=false
HYBRID_PYTHON_CONTROL_PLANE_FAIL_OPEN=false
HYBRID_PYTHON_DEFAULT_ROUTE=/api/hybrid-python/jobs
CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379
